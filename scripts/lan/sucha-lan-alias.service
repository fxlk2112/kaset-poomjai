[Unit]
Description=FARMULTIMATE local farm hostname
After=avahi-daemon.service network-online.target
Wants=avahi-daemon.service network-online.target

[Service]
User=sucha-farm-lan
Group=sucha-farm-lan
ExecStart=/usr/bin/python3 /opt/sucha-farm-lan/app/publish_alias.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
