{
  "name": "flytech-farmultimate-owner-staging",
  "main": "worker/frontend-owner.js",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": {
    "directory": "./.cloudflare-staging-dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/photo/*"]
  },
  "services": [
    {
      "binding": "FARMULTIMATE_API",
      "service": "flytech-farmultimate-api-canary"
    }
  ]
}
